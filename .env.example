# Names only. Never put values in this file or in the repository.
# Real values live only in the hosting server's environment (set during the key window).

# mock (default) | real. real refuses to start without MODEL_API_KEY.
CLOSER_MODE=

# Meta Model API key (server environment only).
MODEL_API_KEY=

# Optional override of the Model API base URL (default is the documented one).
META_API_BASE_URL=

# Required for /admin outside local mock mode.
CLOSER_ADMIN_TOKEN=

# SQLite file path for the ledger (default: .data/closer.db).
CLOSER_DB_PATH=

# Injected "today" (YYYY-MM-DD, KST). Default: today's KST date from the server clock.
CLOSER_TODAY=

# HTTP port for the local server (default 8787).
CLOSER_PORT=

# SAM mask-in-box tolerance in whole pixels, optional. Unset: max(8, 5% of the prompted box side).
CLOSER_MASK_TOLERANCE_PX=

# 1 = also send metadata.mask_encoding one_bit with SAM requests (off by default; box prompts return one_bit anyway).
CLOSER_SAM_METADATA=

# 1 only behind a reverse proxy that is the one peer able to reach the server (the deploy kit's Caddy):
# the per-address rate limits then read the last X-Forwarded-For entry instead of the socket address.
CLOSER_TRUST_PROXY=

# Money caps in USD, optional. Defaults: visitor live calls per day 0, app total 20.
# Raise the visitor cap only for a judging window (ceiling 10); it is $0 from 2026-11-19 00:00 KST regardless.
CLOSER_VISITOR_DAY_USD=
CLOSER_APP_TOTAL_USD=
