{
  "name": "closer-rail-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:ui": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test server/scan.test.ts server/routes.test.ts src/utils/ledgerLogic.test.ts src/utils/tiles.test.ts src/components/InspectorLogic.test.ts src/utils/tagForms.test.ts src/utils/review.test.ts",
    "live:scan": "tsx scripts/live_scan_check.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@meta-sam/parser": "0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "d3": "^7.9.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=22.18"
  }
}
