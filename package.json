{
  "name": "closer",
  "version": "0.1.0",
  "private": true,
  "description": "Wardrobe assistant: keep what you want to wear, change only what feels off, count only confirmed wears.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/reporter.mjs --test-reporter-destination=docs/at_results.json \"tests/**/*.test.ts\"; s=$?; node scripts/at_report.ts; exit $s",
    "ui": "node --disable-warning=ExperimentalWarning web/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "screens": "node scripts/screenshots.cjs",
    "live:check": "bash scripts/with-key.sh node --disable-warning=ExperimentalWarning scripts/live_check.ts --live",
    "live:ablation": "bash scripts/with-key.sh node --disable-warning=ExperimentalWarning scripts/intent_ablation.ts --live",
    "live:ui": "CLOSER_MODE=real CLOSER_VISITOR_DAY_USD=3 bash scripts/with-key.sh node --disable-warning=ExperimentalWarning web/server.ts",
    "wonder": "bash scripts/with-key.sh node --disable-warning=ExperimentalWarning scripts/wonder.ts --live"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "three": "0.170.0"
  }
}
