{
  "name": "closer",
  "version": "0.1.0",
  "private": true,
  "description": "Wardrobe assistant: keep what you want to wear, change only what feels off, count only confirmed wears.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./tests/reporter.mjs --test-reporter-destination=docs/at_results.json \"tests/**/*.test.ts\" && node scripts/at_report.ts",
    "ui": "node --disable-warning=ExperimentalWarning web/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "screens": "node scripts/screenshots.cjs"
  }
}
